{
  "name": "wrekin-cloud",
  "private": true,
  "type": "module",
  "description": "The Wrekin relay: TanStack Start + tRPC + Better Auth + a per-account Durable Object on Cloudflare Workers",
  "scripts": {
    "dev": "vite dev",
    "build": "bun run scripts/render-wrangler.ts && CLOUDFLARE_VITE_WRANGLER_CONFIG_PATH=wrangler.deploy.json vite build",
    "deploy": "wrangler d1 migrations apply wrekin --remote -c wrangler.deploy.json && wrangler deploy -c dist/server/wrangler.json",
    "typecheck": "tsc --noEmit",
    "test": "vite build && vitest run",
    "test:node": "vitest run --config vitest.node.config.ts",
    "db:generate": "bun run scripts/generate-auth-migration.ts",
    "db:migrate:local": "wrangler d1 migrations apply wrekin --local -c wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply wrekin --remote -c wrangler.deploy.json"
  },
  "dependencies": {
    "@better-auth/mcp": "^1.7.18",
    "@better-auth/oauth-provider": "^1.7.18",
    "@modelcontextprotocol/server": "^2.4.0",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "@trpc/client": "^11.24.0",
    "@trpc/server": "^11.24.0",
    "@trpc/tanstack-react-query": "^11.24.0",
    "better-auth": "^1.7.18",
    "jose": "^6.2.3",
    "kysely": "^0.29.8",
    "kysely-d1": "^0.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@better-auth/core": "1.7.18",
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^4.1.0",
    "wrangler": "^4.158.0"
  }
}
