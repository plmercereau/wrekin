// Wrangler configuration for the Wrekin relay: what belongs to the code.
//
// What belongs to a deployment is not here. The D1 database, the Worker
// entity and the name wrekin.platyplus.io are the platyplus/infrastructure
// stack's (sites/wrekin/tofu); Workers Builds deploys this directory on every
// push to main, and `bun run build` (scripts/render-wrangler.ts) writes
// wrangler.deploy.json from this file plus two build variables, the database's
// id (WREKIN_D1_DATABASE_ID) and the public URL (WREKIN_BASE_URL), before Vite
// builds the Worker from it into dist/wrekin/. The values below for those two
// are for local development only.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wrekin",
  // The custom TanStack Start server entry, not "@tanstack/react-start/server-entry": the
  // Durable Object class must be exported from the Worker's main module, and the Vite plugin
  // bundles whatever `main` names (src/server.ts re-exports AccountHub).
  "main": "src/server.ts",
  // Latest date supported by the workerd bundled with wrangler 4.158 (1.20261104.1).
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat"],
  // The name is the stack's custom domain, never a workers.dev one.
  "workers_dev": false,
  "vars": {
    "BASE_URL": "http://localhost:8787"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wrekin",
      // Local development key; the real id comes from the build variable.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ACCOUNT_HUB", "class_name": "AccountHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AccountHub"] }],
  "observability": { "enabled": true }
}
